{
  "manifest_version": 3,
  "name": "DMIT AS3 官方库存监控",
  "version": "1.0.0",
  "description": "仅监控官方 AS3 TINY / Pocket；通过本机桥接沿用 Telegram 通知。",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.dmit.io/*",
    "https://dmit.io/*"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DMIT AS3 监控"
  }
}
